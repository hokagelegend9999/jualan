#!/bin/bash

# ==================================================
#            PERSIAPAN & DEPENDENSI
# ==================================================
apt-get install ruby zip unzip wget -y > /dev/null 2>&1
if ! command -v lolcat &> /dev/null; then
    gem install lolcat &> /dev/null
fi

clear

# ==================================================
#            FUNGSI ANIMASI LOADING
# ==================================================
fun_bar() {
    CMD="$1"
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        $CMD >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &

    tput civis 
    echo -ne "  \033[0;33mSedang Memproses Update \033[1;37m- \033[0;33m["
    
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "\033[0;32m#"
            sleep 0.1s
        done
        if [[ -e $HOME/fim ]]; then
            rm $HOME/fim
            break
        fi
        echo -e "\033[0;33m]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "  \033[0;33mSedang Memproses Update \033[1;37m- \033[0;33m["
    done
    
    echo -e "\033[0;33m]\033[1;37m -\033[1;32m SUKSES !\033[1;37m"
    tput cnorm 
}

# ==================================================
#            FUNGSI UPDATE UTAMA
# ==================================================
res1() {
    # 1. Hentikan service agar file tidak terkunci
    systemctl stop kyt > /dev/null 2>&1

    # 2. Backup data penting (Database, var, dan Config)
    # Ini supaya saldo dan pengaturan bot tidak hilang setelah update
    mkdir -p /tmp/backup_kyt
    cp /usr/bin/kyt/database.db /tmp/backup_kyt/ > /dev/null 2>&1
    cp /usr/bin/kyt/var.txt /tmp/backup_kyt/ > /dev/null 2>&1
    cp /usr/bin/kyt/modules/config.py /tmp/backup_kyt/ > /dev/null 2>&1

    # 3. Bersihkan folder lama
    rm -rf /usr/bin/kyt
    mkdir -p /usr/bin/kyt
    mkdir -p /tmp/kyt_new

    # 4. Download dari GitHub Baru (hokagelegend9999/jualan)
    # Menggunakan link RAW agar bisa didownload langsung oleh VPS
    wget -q -O /tmp/kyt_new/kyt.zip "https://raw.githubusercontent.com/hokagelegend9999/jualan/main/kyt.zip"
    
    # 5. Ekstrak file
    unzip -o /tmp/kyt_new/kyt.zip -d /tmp/kyt_new/ > /dev/null 2>&1

    # 6. Perbaikan Struktur (Menangani folder 'kyt' di dalam ZIP)
    # Karena di gambar ZIP Anda ada folder 'kyt', kita ambil isinya saja
    if [ -d "/tmp/kyt_new/kyt" ]; then
        cp -r /tmp/kyt_new/kyt/* /usr/bin/kyt/
    else
        cp -r /tmp/kyt_new/* /usr/bin/kyt/
    fi

    # 7. Restore Data Backup
    cp /tmp/backup_kyt/database.db /usr/bin/kyt/ > /dev/null 2>&1
    cp /tmp/backup_kyt/var.txt /usr/bin/kyt/ > /dev/null 2>&1
    mkdir -p /usr/bin/kyt/modules
    cp /tmp/backup_kyt/config.py /usr/bin/kyt/modules/ > /dev/null 2>&1

    # 8. Set Izin Eksekusi
    chmod +x -R /usr/bin/kyt/
    
    # Bersihkan sampah
    rm -rf /tmp/kyt_new
    rm -rf /tmp/backup_kyt

    # 9. Restart Service
    systemctl daemon-reload
    systemctl restart kyt
}

# ==================================================
#            EKSEKUSI
# ==================================================
clear
echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" | lolcat
echo -e " \e[1;97;101m UPDATE BOT - REPO HOKAGELEGEND9999  \e[0m"
echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" | lolcat
echo -e ""
echo -e "  \033[1;91m Menghapus & Mengunduh Script Baru...\033[1;37m"

fun_bar 'res1'

echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" | lolcat
echo -e ""
echo -e " \033[1;32m Update Selesai! Struktur folder telah diperbaiki.\033[0m"
echo -e ""
read -n 1 -s -r -p "Tekan [ Enter ] untuk kembali"
